[Unit]
Description=UFW Telegram Bildirim Servisi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/ufw-telegram.conf
ExecStart=/usr/bin/python3 /usr/local/bin/ufw_telegram.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
